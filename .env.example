# ---------------------------------------------------------------------------
# FRONTEND (Vite) — anything prefixed VITE_ is PUBLIC and shipped to the
# browser. Never put a secret here. No exceptions.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# BACKEND ONLY — never prefixed with VITE_, never imported by src/.
# Keep this file's real counterpart (.env) out of git.
# ---------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Where customer inquiries and booking notifications are delivered
OWNER_EMAIL=talaseventcateringservices@gmail.com

# SMTP / transactional email provider — using Gmail's SMTP relay.
# SMTP_PASSWORD must be a 16-character Gmail "App Password", NOT the normal
# Gmail account password — Google blocks regular-password SMTP login entirely.
# See README.md "Setting up email" for how to generate one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=talaseventcateringservices@gmail.com
SMTP_PASSWORD=
MAIL_FROM="Tala's Event Catering Services <talaseventcateringservices@gmail.com>"

# Maya — populate once the client's Maya Business account is active.
# MAYA_SECRET_KEY must never appear in any VITE_ variable or in src/.
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=
MAYA_ENVIRONMENT=sandbox
