# ---------------------------------------------------------------------------
# FRONTEND (Vite) — anything prefixed VITE_ is PUBLIC and shipped to the
# browser. Never put a secret here. No exceptions.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# BACKEND ONLY — never prefixed with VITE_, never imported by src/.
# Keep this file's real counterpart (.env) out of git.
# ---------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Where customer inquiries and booking notifications are delivered
OWNER_EMAIL=

# Resend (transactional email API — used instead of raw SMTP because most
# free hosts, including Render's free tier, block outbound SMTP ports).
# Get a key at https://resend.com/api-keys after signing up.
# See README.md "Setting up email" for full setup, including domain
# verification — required because Resend cannot send FROM a Gmail address;
# it can only send FROM a domain you've verified you control (tala-ecs.com).
RESEND_API_KEY=

# Must be on a domain verified in Resend, NOT a Gmail address — see note
# above. OWNER_EMAIL above (the recipient) can still be Gmail; only the
# "from" address has this restriction.
MAIL_FROM="Tala's Event Catering Services <inquiries@tala-ecs.com>"

# ---------------------------------------------------------------------------
# Database (Supabase Postgres) — use the SESSION POOLER connection string
# (Supabase: Connect -> Direct -> Method: Session pooler, port 5432). If the
# password has symbols such as @ : / ? + percent-encode them, or reset it to
# letters and numbers only. Never commit this value.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Optional: PEM text of Supabase's CA certificate to fully verify the TLS
# connection. Without it the connection is encrypted but not verified.
# DATABASE_CA_CERT=

# ---------------------------------------------------------------------------
# Maya Checkout. MAYA_ENVIRONMENT must be exactly "sandbox" or "production";
# anything else switches online booking OFF (the API answers 503).
# Create Checkout uses the PUBLIC key; payment look-ups use the SECRET key.
# Neither may ever appear in a VITE_ variable or in src/.
# ---------------------------------------------------------------------------
MAYA_ENVIRONMENT=
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=

# Public site URL Maya sends customers back to (no trailing slash).
FRONTEND_URL=https://www.tala-ecs.com

# Maya does not sign webhooks. The server only accepts webhook calls from
# Maya's published IPs, read from the header your host sets. On Render use:
CLIENT_IP_HEADER=true-client-ip
# Optional override of the allowed webhook IPs (comma separated). Leave empty
# to use Maya's published production/sandbox addresses.
# MAYA_WEBHOOK_IPS=

# Tax added to hotel totals. [NEEDS PROOF] confirm with the client whether the
# hotel rates already include VAT. If you change it, also change TAX_RATE in
# src/components/hotels/BookingSummary.jsx so the page shows the same total.
TAX_RATE=0.12
